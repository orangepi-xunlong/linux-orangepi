				15 00 02 A2 15
				15 00 02 A3 14
				15 00 02 A4 1B
				15 00 02 A5 2F
				15 00 02 A6 25
				15 00 02 A7 24
				15 00 02 A8 80
				15 00 02 A9 1F
				15 00 02 AA 2C
				15 00 02 AB 6C
				15 00 02 AC 16
				15 00 02 AD 14
				15 00 02 AE 4D
				15 00 02 AF 20
				15 00 02 B0 29
				15 00 02 B1 4F
				15 00 02 B2 5F
				15 00 02 B3 23
				15 00 02 C0 00
				15 00 02 C1 2E
				15 00 02 C2 3B
				15 00 02 C3 15
				15 00 02 C4 16
				15 00 02 C5 28
				15 00 02 C6 1A
				15 00 02 C7 1C
				15 00 02 C8 A7
				15 00 02 C9 1B
				15 00 02 CA 28
				15 00 02 CB 92
				15 00 02 CC 1F
				15 00 02 CD 1C
				15 00 02 CE 4B
				15 00 02 CF 1F
				15 00 02 D0 28
				15 00 02 D1 4E
				15 00 02 D2 5C
				15 00 02 D3 23
				39 00 04 FF 98 81 00
				15 00 02 11 00
				15 78 02 29 00
				15 00 02 35 00
		];
		display-timings {
			native-mode = <&panel_timing>;

			panel_timing: timing0 {
				clock-frequency = <62100000>;
				hactive = <800>;
				hfront-porch = <40>;
				hback-porch = <20>;
				hsync-len = <5>;
				vactive = <1280>;
				vfront-porch = <30>;
				vback-porch = <12>;
				vsync-len = <5>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <0>;
			};
		};


		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi0_out_panel>;
			};
		};
	};
};

&dsi0_out {
	dsi0_out_panel: endpoint {
		remote-endpoint = <&panel_in_dsi>;
	};
};

&dsi0_in {
	dsi0_in_vp2: endpoint {
		remote-endpoint = <&vp2_out_dsi0>;
	};
};

&vp2 {
	#address-cells = <1>;
	#size-cells = <0>;

	vp2_out_dsi0: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi0_in_vp2>;
	};
};
