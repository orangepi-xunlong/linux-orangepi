				39 10 02 C4 16
				39 10 02 C5 28
				39 10 02 C6 1A
				39 10 02 C7 1C
				39 10 02 C8 A7
				39 10 02 C9 1B
				39 10 02 CA 28
				39 10 02 CB 92
				39 10 02 CC 1F
				39 10 02 CD 1C
				39 10 02 CE 4B
				39 10 02 CF 1F
				39 10 02 D0 28
				39 10 02 D1 4E
				39 10 02 D2 5C
				39 10 02 D3 23

				39 10 04 FF 98 81 00
				39 10 02 11 00
				39 78 02 29 00
				39 10 02 35 00
		];

		panel-exit-sequence = [
			05 00 01 28
			05 78 01 10
		];

		display-timings {
			native-mode = <&timing0>;
			timing0: timing0 {
				clock-frequency = <68215200>;
				hback-porch = <20>;
				hactive = <800>;
				hfront-porch = <20>;
				hsync-len = <20>;
				vback-porch = <8>;
				vactive = <1280>;
				vfront-porch = <30>;
				vsync-len = <4>;
			};
		};
		port {
			panel0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&panel_output_0>;
			};
		};
	};
	phy_switcher: phy_switcher@10 {
		compatible = "allwinner,sunxi-phy-switcher";
		reg = <0x0 0x10 0x0 0x0>;
		//aux_p = <&r_pio PL 12 GPIO_ACTIVE_HIGH>;
		//aux_n = <&r_pio PL 13 GPIO_ACTIVE_HIGH>;
		phys = <&combo0_dp>, <&combo0_usb>;
		phy-names = "dp-phy", "usb-phy";
		//extcon = <&usb_power_supply>;
		//usb_psy = <&reg_usb0_vbus>;
		dp_configure_delay = <50>;

		status = "okay";

		mode-switch;
		orientation-switch;
		svid = <0xff01>;
		port {
			#address-cells = <1>;
			#size-cells = <0>;
			usbdp_orientation_switch: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&usbc2_orien_sw>;
			};
			usbdp_dp_altmode_mux: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dp_altmode_mux>;
			};
		};
	};
};

&ccu {
	clk-init-gate = <1>;
};

