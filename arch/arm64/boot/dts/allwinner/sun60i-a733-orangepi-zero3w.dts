	};

	s_irrx_pins_sleep: s_irrx@1 {
		pins = "PL4";
		function = "gpio_in";
	};

	s_pwm0_2_pins_active:s_pwm0_2@0 {
		pins = "PL4";
		function = "s_pwm0_2";
		drive-strength = <10>;
	};

	s_pwm0_2_pins_sleep:s_pwm0_2@1 {
		pins = "PL4";
		function = "gpio_in";
		bias-pull-down;
	};

	s_pwm0_7_pins_active:s_pwm0@0 {
		pins = "PL9";
		function = "s_pwm0_7";
		drive-strength = <10>;
	};

	s_pwm0_7_pins_sleep:s_pwm0@1 {
		pins = "PL9";
		function = "gpio_in";
		bias-pull-down;
	};

	uart7_pins_active: uart7_pins@0 {
		pins = "PL2", "PL3";
		function = "s_uart0";
		drive-strength = <10>;
	};

	uart7_pins_sleep: uart7_pins@1 {
		pins = "PL2","PL3";
		function = "io_disabled";
		drive-strength = <10>;
	};

	uart8_pins_active: uart8_pins@0 {
		pins = "PL8", "PL9";
		function = "s_uart1";
		drive-strength = <10>;
	};

	uart8_pins_sleep: uart8_pins@1 {
		pins = "PL8","PL9";
		function = "io_disabled";
		drive-strength = <10>;
	};

};

