		function = "pwm0_6";
		drive-strength = <10>;
	};

	pwm0_6_pins_sleep: pwm0_6@1 {
		pins = "PD6";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm0_7_pins_active: pwm0_7@0 {
		pins = "PD7";
		function = "pwm0_7";
		drive-strength = <10>;
	};

	pwm0_7_pins_sleep: pwm0_7@1 {
		pins = "PD7";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm0_8_pins_active: pwm0_8@0 {
		pins = "PB6";
