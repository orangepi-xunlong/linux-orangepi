	};

	pwm0_8_pins_sleep: pwm0_8@1 {
		pins = "PB6";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm0_9_pins_active: pwm0_9@0 {
		pins = "PB7";
		function = "pwm0_9";
		drive-strength = <10>;
	};

	pwm0_9_pins_sleep: pwm0_9@1 {
		pins = "PB7";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm1_7_pins_active: pwm1_7@0 {
		pins = "PJ25";
		function = "pwm1_7";
		drive-strength = <10>;
	};

	pwm1_7_pins_sleep: pwm1_7@1 {
		pins = "PJ25";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm1_8_pins_active: pwm1_8@0 {
		pins = "PJ26";
		function = "pwm1_8";
		drive-strength = <10>;
	};

	pwm1_8_pins_sleep: pwm1@1 {
		pins = "PJ26";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm1_3_pins_active: pwm1@0 {
		pins = "PG2";
		function = "pwm1_3";
		drive-strength = <10>;
	};

	pwm1_3_pins_sleep: pwm1@1 {
		pins = "PG2";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm1_9_pins_active: pwm1@0 {
		pins = "PK5";
		function = "pwm1_9";
		drive-strength = <10>;
	};

	pwm1_9_pins_sleep: pwm1@1 {
		pins = "PK5";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm1_6_pins_active: pwm6@0 {
		pins = "PI15";
		function = "pwm1_6";
		drive-strength = <10>;
	};

	pwm1_6_pins_sleep: pwm6@1 {
		pins = "PI15";
		function = "gpio_in";
		bias-pull-down;
	};

	twi0_pins_default: twi0@0 {
		pins = "PB2", "PB3";
		function = "twi0";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi0_pins_sleep: twi0@1 {
		pins = "PB2", "PB3";
		function = "gpio_in";
	};

	twi1_pins_default: twi1@0 {
		pins = "PB7", "PB8";
		function = "twi1";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi1_pins_sleep: twi1@1 {
		pins = "PB7", "PB8";
		function = "gpio_in";
	};

	twi2_pins_default: twi2@0 {
		pins = "PE1", "PE2";
		function = "twi2";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi2_pins_sleep: twi2@1 {
		pins = "PE1", "PE2";
		function = "gpio_in";
	};

	twi3_pins_default: twi3@0 {
		pins = "PE3", "PE4";
		function = "twi3";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi3_pins_sleep: twi3@1 {
		pins = "PE3", "PE4";
		function = "gpio_in";
	};

	twi5_pins_default: twi5@0 {
		pins = "PJ26", "PJ27";
		function = "twi5";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi5_pins_sleep: twi5@1 {
		pins = "PJ26", "PJ27";
		function = "gpio_in";
	};

	twi7_pins_default: twi7@0 {
		pins = "PJ22", "PJ23";
		function = "twi7";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi7_pins_sleep: twi7@1 {
		pins = "PJ22", "PJ23";
		function = "gpio_in";
	};

	twi8_pins_default: twi8@0 {
		pins = "PB9", "PB10";
		function = "twi8";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi8_pins_sleep: twi8@1 {
		pins = "PB9", "PB10";
		function = "gpio_in";
	};

	twi9_pins_default: twi9@0 {
		pins = "PE14", "PE15";
		function = "twi9";
		drive-strength = <40>;
		bias-pull-up;
	};

	twi9_pins_sleep: twi9@1 {
		pins = "PE14", "PE15";
		function = "gpio_in";
	};

	twi11_pins_default: twi11@0 {
		pins = "PE7", "PE8";
		function = "twi11";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi11_pins_sleep: twi11@1 {
		pins = "PE7", "PE8";
		function = "gpio_in";
	};

	twi12_pins_default: twi12@0 {
		pins = "PK24", "PK25";
		function = "twi12";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi12_pins_sleep: twi12@1 {
		pins = "PK24", "PK25";
		function = "gpio_in";
	};

	/* i2s0 pins */
	i2s0_pins_a: i2s0@0 {
		pins = "PB4";
		function = "i2s0_mclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_b: i2s0@1 {
		pins = "PB5";
		function = "i2s0_bclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_c: i2s0@2 {
		pins = "PB6";
		function = "i2s0_lrck";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_e: i2s0@4 {
		pins = "PB7";
		function = "i2s0_dout0";
		allwinner,drive = <1>;
		bias-pull-down;
	};

	i2s0_pins_d: i2s0@3 {
		pins = "PB8";
		function = "i2s0_din0";
		allwinner,drive = <1>;
		bias-pull-down;
	};

	i2s0_pins_f: i2s0@5 {
		pins = "PB4", "PB5", "PB6", "PB7", "PB8";
		function = "io_disabled";
		allwinner,drive = <1>;
		bias-disable;
	};

	/* i2s1 pins */
	i2s1_pins_a: i2s1@0 {
		pins = "PG10";
		function = "i2s1_mclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s1_pins_b: i2s1@1 {
		pins = "PG11";
		function = "i2s1_bclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s1_pins_c: i2s1@2 {
		pins = "PG12";
		function = "i2s1_lrck";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s1_pins_d: i2s1@3 {
		pins = "PG13";
		function = "i2s1_dout0";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s1_pins_e: i2s1@4 {
		pins = "PG14";
		function = "i2s1_din0";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s1_pins_f: i2s1@5 {
		pins = "PG10", "PG11", "PG12", "PG13", "PG14";
		function = "io_disabled";
		allwinner,drive = <1>;
		bias-disable;
	};

	/* i2s2 pins */
	i2s2_pins_b: i2s2@1 {
		pins = "PH3";
		function = "i2s2_bclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s2_pins_c: i2s2@2 {
		pins = "PH4";
		function = "i2s2_lrck";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s2_pins_d: i2s2@3 {
		pins = "PH6";
		function = "i2s2_din0";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s2_pins_e: i2s2@4 {
		pins = "PH5";
		function = "i2s2_dout0";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s2_pins_f: i2s2@5 {
		pins = "PH3", "PH4", "PH5", "PH6";
		function = "io_disabled";
		allwinner,drive = <1>;
		bias-disable;
	};

	/* i2s3 pins */
	i2s3_pins_a: i2s3@0 {
		pins = "PE7";
		function = "i2s3_bclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s3_pins_b: i2s3@1 {
		pins = "PE8";
		function = "i2s3_lrck";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s3_pins_c: i2s3@2 {
		pins = "PE9";
		function = "i2s3_mclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s3_pins_d: i2s1@3 {
		pins = "PE10";
		function = "i2s3_din3";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s3_pins_e: i2s3@4 {
		pins = "PE11";
		function = "i2s3_dout2";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s3_pins_f: i2s3@5 {
		pins = "PE7", "PE8", "PE9", "PE10", "PE11";
		function = "io_disabled";
		allwinner,drive = <1>;
		bias-disable;
	};

	/* i2s4 pins */
	i2s4_pins_a: i2s4@0 {
		pins = "PK1";
		function = "i2s4_mclk";
		drive-strength = <20>;
		bias-disable;
	};

	i2s4_pins_b: i2s4@1 {
		pins = "PK0";
		function = "i2s4_bclk";
		drive-strength = <20>;
		bias-disable;
	};

	i2s4_pins_c: i2s4@2 {
		pins = "PK2";
		function = "i2s4_lrck";
		drive-strength = <20>;
		bias-disable;
	};

	i2s4_pins_d: i2s4@3 {
		pins = "PK4";
		function = "i2s4_dout0";
		drive-strength = <20>;
		bias-disable;
	};

	i2s4_pins_e: i2s4@4 {
		pins = "PK3";
		function = "i2s4_din0";
		drive-strength = <20>;
		bias-disable;
	};

	i2s4_pins_f: i2s4@5 {
		pins = "PK0", "PK1", "PK2", "PK3", "PK4";
		function = "io_disabled";
		drive-strength = <20>;
		bias-disable;
	};

	owa_pins_a: owa@0 {
		pins = "PI10";
		function = "owa0";
		allwinner,drive = <1>;
		bias-disable;
	};

	owa_pins_b: owa@1 {
		pins = "PI10";
		function = "io_disabled";
		allwinner,drive = <1>;
		bias-disable;
	};

	gmac0_pins_default: gmac0@0 {
		pins = "PH0", "PH1", "PH2", "PH3", "PH4", "PH5", "PH6", "PH7",
			"PH8", "PH9", "PH10", "PH11", "PH12","PH13", "PH14", "PH15";
		function = "rgmii0";
		allwinner,drive = <1>;
		bias-pull-up;
	};

	gmac0_pins_sleep: gmac0@1 {
		pins = "PH0", "PH1", "PH2", "PH3", "PH4", "PH5", "PH6", "PH7",
			"PH8", "PH9", "PH10", "PH11", "PH12","PH13", "PH14", "PH15";
		function = "io_disabled";
	};

	spi0_pins_default: spi0@0 {
		pins = "PC12", "PC2", "PC4"; /* clk, mosi, miso */
		function = "spi0";
		allwinner,drive = <1>;
		//drive-strength = <20>;
	};

	spi0_pins_cs: spi0@1 {
		pins = "PC3"; /* cs */
		function = "spi0";
		allwinner,drive = <1>;
		//drive-strength = <20>;
		bias-pull-up;
	};

	spi0_pins_sleep: spi0@2 {
		pins = "PC12", "PC2", "PC4", "PC3";
		function = "io_disabled";
	};

	spi3_pin_default: spi3_pin_default{
		pins = "PE1","PE2","PE3","PE4","PE0";
		function = "spi3";
	};

	spi3_pin_sleep: spi3_pin_sleep{
		pins = "PE1","PE2","PE3","PE4","PE0";
		function = "gpio_in";
	};

	ledc_pins_a: ledc@0 {
		pins = "PE4";
		function = "ledc";
		drive-strength = <10>;
	};

	ledc_pins_b: ledc@1 {
		pins = "PE4";
		function = "gpio_in";
	};
};

