&de {
	assigned-clock-rates = <600000000>;
	chn_cfg_mode = <2>;
	status = "okay";
};

&dlcd1 {
	status = "disabled";
};

&dlcd2 {
	status = "disabled";
};

&dsi1 {
	status = "disabled";
	pinctrl-0 = <&dsi1_4lane_pins_a>;
	pinctrl-1 = <&dsi1_4lane_pins_b>;
	pinctrl-names = "active","sleep";

	ports {
		dsi1_out: port@1{
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_input>;
			};
		};
	};
	panel: panel@0 {
		compatible = "allwinner,virtual-panel";
		status = "okay";
		reg = <0>;
		ports {
			panel_in: port@0 {
				reg = <0>;
				panel_input: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dsi_out_panel>;
				};
			};
			panel_out: port@1 {
				reg = <1>;
				panel_output_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&panel0_in>;
				};
			};
		};
	};
};

&lvds0 {
	status = "disabled";
	dual-channel = <0>;
	pinctrl-0 = <&lvds0_pins_a>;
	pinctrl-1 = <&lvds0_pins_b>;
	/* dual lvds */
	// dual-channel = <1>;
	// pinctrl-0 = <&lvds0_pins_a &lvds1_pins_a>;
	// pinctrl-1 = <&lvds0_pins_b &lvds1_pins_b>;
	pinctrl-names = "active","sleep";
	ports {
		port@1 {
			reg = <1>;
			lvds_panel_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&lvds_panel_in>;
			};
		};
	};
};

&lvds1 {
	status = "disabled";
	dual-channel = <0>;
	pinctrl-0 = <&lvds2_pins_a>;
	pinctrl-1 = <&lvds2_pins_b>;
	/* dual lvds */
	// dual-channel = <1>;
	// pinctrl-0 = <&lvds0_pins_a &lvds1_pins_a>;
	// pinctrl-1 = <&lvds0_pins_b &lvds1_pins_b>;
	pinctrl-names = "active","sleep";
	ports {
		port@1 {
			reg = <1>;
			lvds1_panel_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&lvds1_panel_in>;
			};
		};
