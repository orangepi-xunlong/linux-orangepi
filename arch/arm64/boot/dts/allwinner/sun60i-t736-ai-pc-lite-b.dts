	vinc32:vinc@5832ff8 {
		vinc14_csi_sel = <2>;
		vinc14_mipi_sel = <0xff>;
		vinc14_isp_sel = <0>;
		vinc14_isp_tx_ch = <0>;
		vinc14_tdm_rx_sel = <0>;
		vinc14_rear_sensor_sel = <0>;
		vinc14_front_sensor_sel = <0>;
		vinc14_sensor_list = <0>;
		device_id = <14>;
		status = "disabled";
	};

	vinc33:vinc@5832ff4 {
		vinc15_csi_sel = <2>;
		vinc15_mipi_sel = <0xff>;
		vinc15_isp_sel = <0>;
		vinc15_isp_tx_ch = <0>;
		vinc15_tdm_rx_sel = <0>;
		vinc15_rear_sensor_sel = <0>;
		vinc15_front_sensor_sel = <0>;
		vinc15_sensor_list = <0>;
		device_id = <15>;
		status = "disabled";
	};

	vinc40:vinc@5834000 {
		vinc16_csi_sel = <2>;
		vinc16_mipi_sel = <2>;
		vinc16_isp_sel = <0>;
		vinc16_isp_tx_ch = <0>;
		vinc16_tdm_rx_sel = <0>;
		vinc16_rear_sensor_sel = <2>;
		vinc16_front_sensor_sel = <2>;
		vinc16_sensor_list = <0>;
		device_id = <16>;
		work_mode = <0x0>;
		status = "okay";
	};

	vinc50:vinc@5835000 {
		vinc17_csi_sel = <2>;
		vinc17_mipi_sel = <2>;
		vinc17_isp_sel = <0>;
		vinc17_isp_tx_ch = <0>;
		vinc17_tdm_rx_sel = <0>;
		vinc17_rear_sensor_sel = <1>;
		vinc17_front_sensor_sel = <1>;
		vinc17_sensor_list = <0>;
		device_id = <17>;
		status = "disabled";
	};
};

&gpu  {
	gpu-supply = <&reg_dcdc5>;
};

&ve {
	ve-supply = <&reg_dcdc5>;
	status		= "okay";
};

&sid {
	sid-supply = <&reg_dldo6>;
	voltage = <1800>;
};

&twi4 {
	clock-frequency = <100000>;
	pinctrl-0 = <&twi4_pins_default>;
	pinctrl-1 = <&twi4_pins_sleep>;
	pinctrl-names = "default", "sleep";
	no_suspend = <1>;
	device_type = "twi4";
	status = "okay";
	/* For stability and backwards compatibility, we recommend setting ‘twi_drv_used’ to 1 */
	twi_drv_used = <1>;

	touchscreen: touchscreen@14 {
		compatible = "goodix,gt9271";
		reg = <0x14>;
		interrupt-parent = <&pio>;
		interrupts = <PE 6 IRQ_TYPE_LEVEL_HIGH>;
		irq-gpios = <&pio PE 6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio PJ 21 GPIO_ACTIVE_HIGH>;
		touchscreen-inverted-x;
		//touchscreen-inverted-y;
		touchscreen-swapped-x-y;
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <800>;
	};

//	ctp: ctp@0 {
//		compatible = "allwinner,goodix";
//		reg = <0x14>;
//		device_type = "ctp";
//		status = "okay";
//		ctp_name = "gt9xxnew_ts";
//		ctp_twi_id = <0x4>;
//		ctp_twi_addr = <0x14>;
