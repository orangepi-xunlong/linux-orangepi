&spi0 {
      clock-frequency = <100000000>;
      pinctrl-names = "default","sleep";
      pinctrl-0 = <&spi0_pins_default>;
      pinctrl-1 = <&spi0_pins_sleep>;

      sunxi,spi-num-cs = <1>;
      sunxi,spi-bus-mode = <SUNXI_SPI_BUS_MASTER>;
      sunxi,spi-cs-mode = <SUNXI_SPI_CS_AUTO>;
      status = "okay";

      spidev@0 {
              reg = <0>;
              compatible = "rohm,dh2228fv";
              spi-max-frequency = <500000>;
              spi-rx-bus-width = <0x1>;
              spi-tx-bus-width = <0x1>;
      };
};

&spi4 {
      clock-frequency = <100000000>;
      pinctrl-names = "default","sleep";
      pinctrl-0 = <&spi4_pins_default>;
      pinctrl-1 = <&spi4_pins_sleep>;

      sunxi,spi-num-cs = <2>;
      sunxi,spi-bus-mode = <SUNXI_SPI_BUS_MASTER>;
      sunxi,spi-cs-mode = <SUNXI_SPI_CS_AUTO>;
      status = "disabled";

      spidev@0 {
              reg = <0>;
              compatible = "rohm,dh2228fv";
              spi-max-frequency = <500000>;
              spi-rx-bus-width = <0x1>;
              spi-tx-bus-width = <0x1>;
      };

      spidev@1 {
              reg = <1>;
              compatible = "rohm,dh2228fv";
              spi-max-frequency = <500000>;
              spi-rx-bus-width = <0x1>;
              spi-tx-bus-width = <0x1>;
      };
};

&twi8 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi8_pins_default>;
	pinctrl-1 = <&twi8_pins_sleep>;
	pinctrl-names = "default", "sleep";
	no_suspend = <1>;
	device_type = "twi8";
	status = "okay";
	/* For stability and backwards compatibility, we recommend setting ‘twi_drv_used’ to 1 */
	twi_drv_used = <1>;
	es8388: es8388@10{
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x10>;
		assigned-clock-rates = <12288000>;
		//pinctrl-names = "default";
		//pinctrl-0 = <&i2s2m1_mclk>;
	};
};

&uart4{
	status = "disabled";
};

&twi8 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi8_pins_default>;
	pinctrl-1 = <&twi8_pins_sleep>;
	pinctrl-names = "default", "sleep";
	no_suspend = <1>;
	device_type = "twi8";
	status = "okay";
	/* For stability and backwards compatibility, we recommend setting ‘twi_drv_used’ to 1 */
	twi_drv_used = <1>;
	es8388: es8388@10{
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x10>;
		assigned-clock-rates = <12288000>;
		//pinctrl-names = "default";
		//pinctrl-0 = <&i2s2m1_mclk>;
	};
};

&uart4{
	//status = "okay";
	status = "disabled";
};

