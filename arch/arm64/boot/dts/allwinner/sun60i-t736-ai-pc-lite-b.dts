//		//ctp_revert_x_flag = <0x1>;
//		ctp_revert_y_flag = <0x1>;
//		ctp_exchange_x_y_flag = <0x1>;
//		ctp_int_port = <&pio PE 8 GPIO_ACTIVE_LOW>;
//		ctp_wakeup = <&pio PE 5 GPIO_ACTIVE_HIGH>;
//		//ctp-supply = <&reg_cldo2>;
//		//ctp_power_ldo_vol = <3300>;
//	};
};

